# FireGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to Git.

# HTTP port the backend listens on (Render sets this automatically)
PORT=5000

# MQTT broker URL — must match the broker in wokwi/sketch.ino
MQTT_URL=mqtt://broker.hivemq.com

# Deployed Frontend origin for CORS (e.g., https://fireguard-ioe.vercel.app)
# If omitted or empty, all origins (*) are permitted.
FRONTEND_URL=https://fireguard-ioe.vercel.app

# Maximum number of sensor readings to keep in memory
MAX_HISTORY=300

# --- Optional: MongoDB persistence (not required for basic operation) ---
# MONGO_URI=mongodb://localhost:27017/fireguard
