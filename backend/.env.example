# FireGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to Git.

# HTTP port the backend listens on (Render sets this automatically)
PORT=5000

# MQTT broker URL — must match the broker in wokwi/sketch.ino
MQTT_URL=mqtt://broker.hivemq.com

# Deployed Frontend origin for CORS
FRONTEND_URL=https://fireguard-ioe-project.vercel.app

# Maximum number of sensor readings to keep in memory
MAX_HISTORY=300

# ============================================================
# Email Alert Service (Nodemailer / SMTP)
# Configure these in Render Environment Variables for live email delivery
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_FROM="FireGuard Alert System" <your-email@gmail.com>

# Emergency Alert Recipients (Configurable via Env or Web Dashboard)
ALERT_USER_EMAIL=user@example.com
ALERT_AMBULANCE_EMAIL=ambulance-alert@example.com
ALERT_FIRE_DEPT_EMAIL=fire-dept-alert@example.com

# Optional: Default Thresholds
DEFAULT_TEMP_WARNING=40.0
DEFAULT_TEMP_FIRE=60.0
DEFAULT_HUM_WARNING=80.0
DEFAULT_SMOKE_WARNING=2800
DEFAULT_SMOKE_FIRE=3500
