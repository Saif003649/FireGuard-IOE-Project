# FireGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to Git.

# HTTP port the backend listens on (Render sets this automatically)
PORT=5000

# MQTT broker URL — must match the broker in wokwi/sketch.ino
MQTT_URL=mqtt://broker.hivemq.com

# Deployed Frontend origin for CORS
FRONTEND_URL=https://fireguard-ioe-project.vercel.app

# Maximum number of sensor readings to keep in memory
MAX_HISTORY=300

# ============================================================
# Email Alert Service (Resend HTTPS API — Port 443)
# ============================================================
# 1. Sign up at https://resend.com (Free plan: 3,000 emails/month, 100/day)
# 2. Generate an API Key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address:
# - For testing without a custom domain: onboarding@resend.dev
# - For production with a custom verified domain: alerts@yourdomain.com
EMAIL_FROM=onboarding@resend.dev

# Recipient address:
# - IMPORTANT FOR TESTING: When using onboarding@resend.dev, Resend ONLY allows sending
#   to the single email address registered to your Resend account.
ALERT_EMAIL_TO=your-resend-account-email@example.com

# Secret token to protect the POST /api/email/test endpoint
EMAIL_TEST_TOKEN=fireguard-test-secret-2026

# Optional: Emergency contacts for when a custom domain is verified
ALERT_AMBULANCE_EMAIL=ambulance-alert@example.com
ALERT_FIRE_DEPT_EMAIL=fire-dept-alert@example.com

# Optional: Default Detection Thresholds
DEFAULT_TEMP_WARNING=40.0
DEFAULT_TEMP_FIRE=60.0
DEFAULT_HUM_WARNING=80.0
DEFAULT_SMOKE_WARNING=2800
DEFAULT_SMOKE_FIRE=3500
